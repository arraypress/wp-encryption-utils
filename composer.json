{
  "name": "arraypress/wp-encryption-utils",
  "description": "A simple utility library for encrypting and decrypting WordPress data including options, settings, meta, and transients.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/arraypress/wp-encryption-utils/",
  "authors": [
    {
      "name": "David Sherlock",
      "homepage": "https://arraypress.com/"
    }
  ],
  "require": {
    "php": ">=8.2",
    "ext-openssl": "*"
  },
  "autoload": {
    "psr-4": {
      "ArrayPress\\EncryptionUtils\\": "src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "support": {
    "issues": "https://github.com/arraypress/wp-encryption-utils/issues",
    "source": "https://github.com/arraypress/wp-encryption-utils"
  },
  "keywords": [
    "wordpress",
    "encryption",
    "security",
    "options",
    "settings",
    "meta",
    "transients",
    "aes",
    "cryptography",
    "data-protection",
    "secure-storage"
  ],
  "require-dev": {
    "phpunit/phpunit": "^11.0 || ^12.0 || ^13.0",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1"
  },
  "autoload-dev": {
    "psr-4": {
      "ArrayPress\\EncryptionUtils\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs",
    "format": "phpcbf --standard=phpcs-format.xml.dist src",
    "format:check": "phpcs --standard=phpcs-format.xml.dist src"
  }
}
